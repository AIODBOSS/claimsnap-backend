{
  "$schema": "https://schema.railpack.com",
  "buildAptPackages": ["...", "libxcb1", "libxext6", "libsm6", "libxrender1", "libglib2.0-0", "libgl1"],
  "steps": {
    "install": {
      "inputs": ["...", { "local": true, "include": ["."] }],
      "commands": [
        "python -m venv /app/.venv && /app/.venv/bin/pip install -r requirements.txt",
        "/app/.venv/bin/pip uninstall -y opencv-python opencv-python-contrib opencv-contrib-python || true",
        "rm -rf /app/.venv/lib/python*/site-packages/cv2 /app/.venv/lib/python*/site-packages/opencv_*",
        "/app/.venv/bin/pip install --no-cache-dir --force-reinstall opencv-python-headless"
      ]
    }
  },
  "deploy": {
    "aptPackages": ["...", "libxcb1", "libxext6", "libsm6", "libxrender1", "libglib2.0-0", "libgl1"]
  }
}