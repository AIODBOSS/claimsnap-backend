{
  "$schema": "https://schema.railpack.com",
  "buildAptPackages": ["...", "libxcb1", "libxext6", "libsm6", "libxrender1", "libglib2.0-0", "libgl1"],
  "steps": {
    "install": {
      "inputs": ["...", { "local": true, "include": ["."] }],
      "commands": [
        "python -m venv /app/.venv && /app/.venv/bin/pip install -r requirements.txt && /app/.venv/bin/pip uninstall -y opencv-python opencv-python-contrib opencv-contrib-python || true",
        "/app/.venv/bin/pip install --force-reinstall --no-deps opencv-python-headless",
        "/app/.venv/bin/pip show gunicorn"
      ]
    }
  },
  "deploy": {
    "aptPackages": ["...", "libxcb1", "libxext6", "libsm6", "libxrender1", "libglib2.0-0", "libgl1"]
  }
}